# --------------------------------------------------
# Chat Service Configuration
# --------------------------------------------------

# Server port (default: 8002)
PORT=8002

# MongoDB Connection URL (MONGO_URL fallback exists in db.js)
MONGODB_URI=mongodb://localhost:27017/chat_db

# Node Environment Mode (e.g. development, production)
NODE_ENV=development

# Allowed CORS Origins (default: *)
CORS_ORIGIN=*
