# --------------------------------------------------
# Auth Service Configuration
# --------------------------------------------------

# Server port (default: 8001)
PORT=8001

# MongoDB Connection URL
MONGO_URL=mongodb://localhost:27017/auth_db

# Clerk API Authentication Keys (Backend secret & Webhook secret for syncs)
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Secret token used for internal backend-to-backend requests validation
INTERNAL_SERVICE_TOKEN=

# Cryptographic key used to encrypt and decrypt user provider API keys (BYOK)
PROVIDER_CREDENTIALS_SECRET=
